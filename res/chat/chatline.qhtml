<table width=100%><tr class="{tags}"><td class="col_avatar" width=42>{avatar}</td><td class="col_sender" title="{sender}" width={sender_width}>{elided_sender}</td><td width=1>&nbsp;</td><td class="col_text">{text}</td><td class="col_time" width={time_width}>{time}</td><td width={padding}></td></tr></table>
